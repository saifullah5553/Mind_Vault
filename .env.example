# ── Mind_Vault — secrets & environment overrides ──────────────────────────
# Copy this file to `.env` and fill in ONLY what you use. Nothing here is
# required to run the offline pipeline. NEVER commit your real .env.
# Every value below is optional and read via environment variables so that the
# same keys can be provided as GitHub Secrets in CI.

# --- Runtime environment -----------------------------------------------------
MIND_VAULT_ENV=development          # development | production
MIND_VAULT_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Database ----------------------------------------------------------------
# SQLite by default (no config needed). To use Postgres later, set:
# MIND_VAULT_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/mind_vault
# MIND_VAULT_DATABASE_URL=

# --- Natural voice (optional, FREE) ------------------------------------------
# Path to a Piper voice model (.onnx). Download a female English voice from
# https://huggingface.co/rhasspy/piper-voices (e.g. en_US-amy-medium). Or just
# drop the .onnx into storage/voices/ and leave this blank.
# PIPER_MODEL=storage/voices/en_US-amy-medium.onnx

# --- LLM providers (all optional) --------------------------------------------
# Ollama is the recommended FREE local option and needs no key.
# OLLAMA_HOST=http://localhost:11434
# Optional premium fallbacks (only if you choose provider: openai/anthropic):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Free data sources (optional keys for higher rate limits) ----------------
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=mind_vault/0.1 by yourusername

# --- Publishing (only needed for the FINAL go-live step; see docs/PUBLISHING.md)
# Keep publishing.dry_run: true in settings.yaml until you're ready to post.
# YouTube:
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Facebook Page:
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=
# TikTok:
# TIKTOK_ACCESS_TOKEN=
# Instagram (needs the mp4 hosted at a public URL):
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_VIDEO_URL=
