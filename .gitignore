# Secrets — NEVER commit
.env
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Mind_Vault runtime artifacts
logs/*.log
# Runtime storage artifacts (keep the .gitkeep placeholders and the presenter's
# canonical brand portrait storage/presenter/aria.png, which is NOT matched below).
storage/videos/*
storage/audio/*
storage/images/*
storage/thumbnails/*
storage/checkpoints/*
storage/backups/*
storage/voices/*
storage/music/*
storage/review/*
storage/*.json
!storage/**/.gitkeep
*.db
*.sqlite3
mind_vault.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# Wav2Lip working copy (tools/) — large model checkpoints are NOT committed.
tools/Wav2Lip/checkpoints/*.pth
tools/Wav2Lip/face_detection/detection/sfd/*.pth
tools/Wav2Lip/temp/
tools/Wav2Lip/results/
tools/**/__pycache__/
storage/presenter/aria_face*.png
storage/presenter/*_talk_test.mp4
storage/presenter/short4s.wav

# Third-party tool clones (recreate with scripts/setup_lipsync.py)
tools/Wav2Lip/
